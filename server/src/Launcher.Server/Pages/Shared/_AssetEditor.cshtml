@inject Launcher.Server.Pages.LayoutInfo Info
@model EditorViewModel
@{
    var asset = Model.Asset.Asset;
    var setting = Model.Asset.Setting;
    var primary = Model.Asset.Primary;
    var protocols = Enum.GetValues<ConnectionProtocol>();
    var linked = Model.Passwords.Where(p => p.IsLinkedTo(asset)).ToList();
    var assigned = linked.Where(p => p.AssetId == asset.Id).ToList();
    var autoCredential = linked.Count switch
    {
        0 => "nessuna collegata in Hudu",
        1 => $"{linked[0].Name}",
        _ when assigned.Count == 1 => $"{assigned[0].Name}",
        _ => $"{linked.Count} collegate: sceglierne una",
    };
    var ipam = asset.IpamList();
    var (autoHost, _) = ConnectionResolver.ResolveHost(null, asset);
    var fqdn = asset.FqdnFor(setting?.Host ?? autoHost);
    var isSelfHost = string.Equals(setting?.Host, ConnectionResolver.SelfHost, StringComparison.OrdinalIgnoreCase);
    var legacyHost = setting?.Host is { } h && !isSelfHost && !ipam.Contains(h, StringComparer.OrdinalIgnoreCase) ? h : null;
    var autoGateway = setting?.GatewayPeerId is null && primary?.GatewayPeerId is not null
        ? $"Automatico: {primary.GatewayPeerId} ({primary.GatewaySource})"
        : setting?.NoGateway == true ? "Nessun gateway: solo connessione diretta"
        : primary?.DirectOnly == true ? "Cliente senza RustDesk: solo diretta"
        : "Da scegliere (nessun gateway del cliente)";
    var consoleHidden = Model.ConsoleRow?.Hidden == true;
    // Aggiuntive senza host: stesso indirizzo della principale (per le pagine web l'FQDN dell'IPAM, se c'è).
    var primaryIp = setting?.Host ?? autoHost;
    var extraHostHint = primaryIp is null
        ? "Indirizzo del dispositivo"
        : $"Vuoto = {primaryIp}, come la principale" + (fqdn is not null && setting?.WebAddress != ConnectionResolver.WebAddressIp ? $" (pagine web: {fqdn})" : "");
}
@functions {
    private const string NoneValue = Launcher.Server.Pages.IndexModel.NoneValue;

    private static string PasswordLabel(CachedPassword p) =>
        string.IsNullOrWhiteSpace(p.Username) ? p.Name : $"{p.Name} — {p.Username}";

    /// <summary>Etichetta con il tipo di collegamento in Hudu: ★ assegnata, ↔ related, ⚠ non collegata.</summary>
    private static string PasswordLabel(CachedPassword p, CachedAsset asset) =>
        PasswordLabel(p) + (p.AssetId == asset.Id ? " ★" : p.IsLinkedTo(asset) ? " ↔" : " ⚠ non collegata in Hudu");

}

<form method="post" asp-page="/Index" asp-page-handler="SaveAsset" class="editor" data-editor-form>
    <input type="hidden" name="AssetId" value="@asset.Id" />

    <header class="modal-head">
        <div>
            <h2 id="editor-title">@asset.Name</h2>
            <p class="muted small">@Model.Asset.CompanyName · @asset.LayoutName</p>
        </div>
        <button type="button" class="btn btn-ghost btn-icon" data-close-modal title="Chiudi"><svg><use href="#i-x" /></svg></button>
    </header>

    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="hudu-facts">
        <div><span>IP nell'IPAM di Hudu</span><strong class="mono" title="@string.Join(", ", ipam)">@(ipam.Count == 0 ? "—" : string.Join(", ", ipam))</strong></div>
        <div><span>Sistema operativo</span><strong>@(asset.OperatingSystem ?? "—")</strong></div>
        <div><span>Hostname</span><strong class="mono">@(asset.Hostname ?? "—")</strong></div>
        @if (Info.RustDeskEnabled)
        {
            <div><span>ID RustDesk in Hudu</span><strong class="mono">@(asset.RustDeskId ?? "—")</strong></div>
        }
    </div>
    <p class="muted small">I campi vuoti usano i dati di Hudu@(Info.RustDeskEnabled ? " e della rubrica RustDesk" : ""). Compila solo ciò che va corretto.</p>
    @if (ipam.Count == 0)
    {
        <div class="alert alert-warn">
            <strong>Nessun IP nell'IPAM di Hudu per questo asset.</strong>
            Va caricato in Hudu (IP Addresses, collegato all'asset), poi premi "Aggiorna da Hudu" nella pagina del cliente.
            @if (asset.PrimaryIp is not null)
            {
                <span>Per ora si usa @asset.PrimaryIp dal campo del layout.</span>
            }
            @if (asset.HuduUrl is not null)
            {
                <a href="@asset.HuduUrl" target="_blank" rel="noopener noreferrer">Apri in Hudu</a>
            }
        </div>
    }
    else if (setting?.Host is null && primary?.Issues.Any(i => i.Contains("sceglierne uno", StringComparison.Ordinal)) == true)
    {
        <div class="alert alert-warn"><strong>@ipam.Count IP nell'IPAM per questo asset:</strong> scegli quello da usare per la connessione.</div>
    }

    @* Schede: principale, aggiuntive, console (suggerita da Hudu) e "+" per aggiungerne. Ogni scheda ha
       gli stessi campi e le sue impostazioni avanzate; le sezioni seguono il protocollo scelto (site.js). *@
    <div class="conn-tabs" role="tablist" aria-label="Connessioni" data-conn-tabs>
        <button type="button" class="conn-tab is-active" role="tab" aria-selected="true" data-tab="primary">
            <svg><use href="#@Format.Icon(primary?.Protocol ?? Model.GuessedProtocol)" /></svg><span>Principale</span>
        </button>
        @for (var i = 0; i < Model.Extras.Count; i++)
        {
            var extra = Model.Extras[i];
            <button type="button" class="conn-tab" role="tab" aria-selected="false" data-tab="extra-@i">
                <svg><use href="#@Format.Icon(extra.Protocol ?? ConnectionProtocol.Https)" /></svg><span data-tab-label>@extra.Label</span>
            </button>
        }
        @if (Model.HasConsole)
        {
            <button type="button" class="conn-tab @(consoleHidden ? "is-muted" : "")" role="tab" aria-selected="false" data-tab="console">
                <svg><use href="#@(consoleHidden ? "i-eye-off" : "i-shield")" /></svg><span data-tab-label>@(string.IsNullOrWhiteSpace(Model.ConsoleRow?.Label) ? "Console" : Model.ConsoleRow.Label)</span>
            </button>
        }
        <button type="button" class="conn-tab conn-tab-add" data-extra-add data-next-index="@Model.Extras.Count" title="Aggiungi una connessione" aria-label="Aggiungi una connessione">
            <svg><use href="#i-plus" /></svg>
        </button>
    </div>

    <section class="conn-panel" role="tabpanel" data-panel="primary">
        <div class="grid grid-3">
            <label class="field">
                <span>Protocollo</span>
                <select class="input" name="Protocol" data-protocol data-auto-protocol="@Model.GuessedProtocol">
                    <option value="">Automatico (@Format.ProtocolName(Model.GuessedProtocol))</option>
                    @foreach (var p in protocols)
                    {
                        <option value="@p" selected="@(setting?.Protocol == p)">@Format.ProtocolName(p)</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Indirizzo IP (dall'IPAM)</span>
                <select class="input mono" name="Host">
                    <option value="">Automatico (@(autoHost ?? "nessun IP"))</option>
                    @foreach (var ip in ipam)
                    {
                        <option value="@ip" selected="@(string.Equals(setting?.Host, ip, StringComparison.OrdinalIgnoreCase))">@ip</option>
                    }
                    @if (Info.RustDeskEnabled)
                    {
                        <option value="@ConnectionResolver.SelfHost" selected="@isSelfHost">localhost: RustDesk è installato su questo dispositivo</option>
                    }
                    @if (legacyHost is not null)
                    {
                        <option value="@legacyHost" selected>@legacyHost (non nell'IPAM)</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Porta</span>
                <input class="input mono" name="Port" value="@setting?.Port" inputmode="numeric" placeholder="@(primary?.Port > 0 ? primary.Port.ToString() : "")" autocomplete="off" data-port-input />
            </label>
        </div>
        <label class="field" data-for="Http Https">
            <span>Indirizzo delle pagine web</span>
            <select class="input mono" name="WebAddress">
                <option value="">FQDN dall'IPAM (@(fqdn ?? "non presente in Hudu: si usa l'IP"))</option>
                <option value="@ConnectionResolver.WebAddressIp" selected="@(setting?.WebAddress == ConnectionResolver.WebAddressIp)">IP (@(setting?.Host ?? autoHost ?? "nessun IP"))</option>
            </select>
        </label>
        @if (!string.IsNullOrEmpty(setting?.WebUrl))
        {
            <p class="muted small">L'URL scritto a mano in precedenza (<span class="mono">@setting.WebUrl</span>) non si usa più e verrà tolto al salvataggio: l'indirizzo viene dall'FQDN dell'IPAM di Hudu (per un percorso o una porta, scrivere in Hudu l'indirizzo completo, es. https://vcenter.cliente.local/ui).</p>
        }
        <div class="grid grid-2">
            <label class="field" data-for="Rdp Ssh Telnet Winbox Http Https Oracle">
                <span data-for="Rdp Ssh Telnet Winbox">Credenziale (da Hudu, inviata al Launcher)</span>
                <span data-for="Http Https">Credenziale proposta per "Accesso" (da Hudu)</span>
                <span data-for="Oracle">Credenziale (da Hudu: si mostra solo l'utente, la password no)</span>
                <select class="input" name="PasswordId">
                    <option value="">Automatica (@autoCredential)</option>
                    <option value="@NoneValue" selected="@(setting?.NoPassword == true)">Nessuna: si inserisce a mano</option>
                    @foreach (var p in Model.Passwords)
                    {
                        <option value="@p.Id" selected="@(setting?.PasswordId == p.Id)">@PasswordLabel(p, asset)</option>
                    }
                </select>
            </label>
            @if (Info.RustDeskEnabled)
            {
                <div class="field">
                    <label class="field">
                        <span>Gateway RustDesk</span>
                        <input class="input mono" name="Gateway" list="peer-list" data-peer-input value="@setting?.GatewayPeerId" placeholder="@autoGateway" autocomplete="off" spellcheck="false" disabled="@(setting?.NoGateway == true)" />
                    </label>
                    <label class="check check-inline">
                        <input type="checkbox" name="NoGateway" value="true" checked="@(setting?.NoGateway == true)" data-no-gateway />
                        <span>Nessun gateway: solo connessione diretta</span>
                    </label>
                </div>
            }
            else
            {
                @* RustDesk spento: il gateway salvato resta, se un giorno si riattiva. *@
                <input type="hidden" name="Gateway" value="@setting?.GatewayPeerId" />
            }
        </div>
        <partial name="_ConnectionAdvanced" model="@(new ConnectionAdvancedModel("", setting?.RdpOptions, setting?.WebOptions, setting?.DatabaseName, setting?.DatabaseKind, Model.RdpDefaults, Model.WebDefaults))" />
    </section>

    @for (var i = 0; i < Model.Extras.Count; i++)
    {
        var extra = Model.Extras[i];
        var prefix = $"Extras[{i}].";
        <section class="conn-panel" role="tabpanel" data-panel="extra-@i" data-extra-row hidden>
            <input type="hidden" name="@(prefix)Id" value="@extra.Id" />
            <input type="hidden" name="@(prefix)Remove" value="false" data-extra-remove />
            <div class="grid grid-3">
                <label class="field">
                    <span>Nome</span>
                    <input class="input" name="@(prefix)Label" value="@extra.Label" placeholder="es. Interfaccia web" maxlength="40" data-label-input />
                </label>
                <label class="field">
                    <span>Protocollo</span>
                    <select class="input" name="@(prefix)Protocol" data-protocol>
                        @foreach (var p in protocols)
                        {
                            <option value="@p" selected="@(extra.Protocol == p)">@Format.ProtocolName(p)</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Porta</span>
                    <input class="input mono" name="@(prefix)Port" value="@extra.Port" placeholder="predefinita" inputmode="numeric" autocomplete="off" data-port-input />
                </label>
            </div>
            <label class="field">
                <span data-for="Http Https">Host o indirizzo completo (anche https://…)</span>
                <span data-not-for="Http Https">Host o IP</span>
                <input class="input mono" name="@(prefix)Host" value="@(extra.Url ?? extra.Host)" placeholder="@extraHostHint" list="ipam-list" autocomplete="off" spellcheck="false" />
            </label>
            <div class="grid grid-2">
                <label class="field" data-for="Rdp Ssh Telnet Winbox Http Https Oracle">
                    <span data-for="Rdp Ssh Telnet Winbox">Credenziale (da Hudu, inviata al Launcher)</span>
                    <span data-for="Http Https">Credenziale proposta per "Accesso" (da Hudu)</span>
                    <span data-for="Oracle">Credenziale (da Hudu: si mostra solo l'utente, la password no)</span>
                    <select class="input" name="@(prefix)PasswordId">
                        <option value="">Nessuna credenziale</option>
                        @foreach (var p in Model.Passwords)
                        {
                            <option value="@p.Id" selected="@(extra.PasswordId == p.Id)">@PasswordLabel(p, asset)</option>
                        }
                    </select>
                </label>
                @if (Info.RustDeskEnabled)
                {
                    <div class="field">
                        <label class="field">
                            <span>Gateway RustDesk</span>
                            <input class="input mono" name="@(prefix)Gateway" value="@extra.GatewayPeerId" list="peer-list" data-peer-input placeholder="Automatico (come la principale)" autocomplete="off" spellcheck="false" disabled="@extra.NoGateway" />
                        </label>
                        <label class="check check-inline">
                        <input type="checkbox" name="@(prefix)NoGateway" value="true" checked="@(extra.NoGateway)" data-no-gateway />
                        <span>Nessun gateway: solo connessione diretta</span>
                    </label>
                    </div>
                }
                else
                {
                    <input type="hidden" name="@(prefix)Gateway" value="@extra.GatewayPeerId" />
                }
            </div>
            <partial name="_ConnectionAdvanced" model="@(new ConnectionAdvancedModel(prefix, extra.RdpOptions, extra.WebOptions, extra.DatabaseName, extra.DatabaseKind, Model.RdpDefaults, Model.WebDefaults))" />
            <div class="conn-panel-actions">
                <button type="button" class="btn btn-ghost btn-sm danger" data-extra-delete><svg><use href="#i-trash" /></svg>Elimina questa connessione</button>
            </div>
        </section>
    }

    @if (Model.HasConsole)
    {
        var row = Model.ConsoleRow;
        var hudu = Model.HuduConsole;
        var huduText = hudu is { } h2 ? (h2.Url ?? $"{Format.ProtocolName(h2.Protocol)} {h2.Host}:{h2.Port}") : "nessuna console in Hudu";
        <section class="conn-panel" role="tabpanel" data-panel="console" data-console-panel hidden>
            <input type="hidden" name="Console.Id" value="@row?.Id" />
            <p class="muted small">
                Suggerita da Hudu: <span class="mono">@huduText</span>. I campi vuoti seguono Hudu; quelli compilati la sostituiscono.
            </p>
            <div class="grid grid-3">
                <label class="field">
                    <span>Nome</span>
                    <input class="input" name="Console.Label" value="@(row?.Label == "Console" ? "" : row?.Label)" placeholder="Console" maxlength="40" data-label-input data-label-default="Console" />
                </label>
                <label class="field">
                    <span>Protocollo</span>
                    <select class="input" name="Console.Protocol" data-protocol data-auto-protocol="@(hudu?.Protocol ?? ConnectionProtocol.Https)">
                        <option value="">Come in Hudu (@Format.ProtocolName(hudu?.Protocol ?? ConnectionProtocol.Https))</option>
                        @foreach (var p in protocols)
                        {
                            <option value="@p" selected="@(row?.Protocol == p)">@Format.ProtocolName(p)</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Porta</span>
                    <input class="input mono" name="Console.Port" value="@row?.Port" placeholder="@(hudu?.Port.ToString() ?? "predefinita")" inputmode="numeric" autocomplete="off" data-port-input />
                </label>
            </div>
            <label class="field">
                <span data-for="Http Https">Host o indirizzo completo (anche https://…)</span>
                <span data-not-for="Http Https">Host o IP</span>
                <input class="input mono" name="Console.Host" value="@(row?.Url ?? row?.Host)" placeholder="@(hudu?.Url ?? hudu?.Host ?? "es. https://idrac-srv01.cliente.local/")" list="ipam-list" autocomplete="off" spellcheck="false" />
            </label>
            <div class="grid grid-2">
                <label class="field" data-for="Rdp Ssh Telnet Winbox Http Https Oracle">
                    <span data-for="Rdp Ssh Telnet Winbox">Credenziale (da Hudu, inviata al Launcher)</span>
                    <span data-for="Http Https">Credenziale proposta per "Accesso" (da Hudu)</span>
                    <span data-for="Oracle">Credenziale (da Hudu: si mostra solo l'utente, la password no)</span>
                    <select class="input" name="Console.PasswordId">
                        <option value="">Nessuna credenziale</option>
                        @foreach (var p in Model.Passwords)
                        {
                            <option value="@p.Id" selected="@(row?.PasswordId == p.Id)">@PasswordLabel(p, asset)</option>
                        }
                    </select>
                </label>
                @if (Info.RustDeskEnabled)
                {
                    <div class="field">
                        <label class="field">
                            <span>Gateway RustDesk</span>
                            <input class="input mono" name="Console.Gateway" value="@row?.GatewayPeerId" list="peer-list" data-peer-input placeholder="Automatico (gateway del cliente)" autocomplete="off" spellcheck="false" disabled="@(row?.NoGateway == true)" />
                        </label>
                        <label class="check check-inline">
                        <input type="checkbox" name="Console.NoGateway" value="true" checked="@(row?.NoGateway == true)" data-no-gateway />
                        <span>Nessun gateway: solo connessione diretta</span>
                    </label>
                    </div>
                }
                else
                {
                    <input type="hidden" name="Console.Gateway" value="@row?.GatewayPeerId" />
                }
            </div>
            <partial name="_ConnectionAdvanced" model="@(new ConnectionAdvancedModel("Console.", row?.RdpOptions, row?.WebOptions, row?.DatabaseName, row?.DatabaseKind, Model.RdpDefaults, Model.WebDefaults))" />
            <div class="conn-panel-actions">
                <label class="check">
                    <input type="checkbox" name="ConsoleHidden" value="true" checked="@consoleHidden" data-console-hide />
                    <span>Nascondi la console (es. scheda dismessa ma ancora scritta in Hudu)</span>
                </label>
                <button type="button" class="btn btn-ghost btn-sm" data-console-reset title="Svuota i campi: la console torna come in Hudu"><svg><use href="#i-refresh" /></svg>Ripristina da Hudu</button>
            </div>
        </section>
    }

    <template data-extra-template>
        <section class="conn-panel" role="tabpanel" data-panel="extra-__i__" data-extra-row hidden>
            <input type="hidden" name="Extras[__i__].Remove" value="false" data-extra-remove />
            <div class="grid grid-3">
                <label class="field">
                    <span>Nome</span>
                    <input class="input" name="Extras[__i__].Label" placeholder="es. Interfaccia web" maxlength="40" data-label-input />
                </label>
                <label class="field">
                    <span>Protocollo</span>
                    <select class="input" name="Extras[__i__].Protocol" data-protocol>
                        @foreach (var p in protocols)
                        {
                            <option value="@p" selected="@(p == ConnectionProtocol.Https)">@Format.ProtocolName(p)</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Porta</span>
                    <input class="input mono" name="Extras[__i__].Port" placeholder="predefinita" inputmode="numeric" autocomplete="off" data-port-input />
                </label>
            </div>
            <label class="field">
                <span data-for="Http Https">Host o indirizzo completo (anche https://…)</span>
                <span data-not-for="Http Https">Host o IP</span>
                <input class="input mono" name="Extras[__i__].Host" placeholder="@extraHostHint" list="ipam-list" autocomplete="off" spellcheck="false" />
            </label>
            <div class="grid grid-2">
                <label class="field" data-for="Rdp Ssh Telnet Winbox Http Https Oracle">
                    <span data-for="Rdp Ssh Telnet Winbox">Credenziale (da Hudu, inviata al Launcher)</span>
                    <span data-for="Http Https">Credenziale proposta per "Accesso" (da Hudu)</span>
                    <span data-for="Oracle">Credenziale (da Hudu: si mostra solo l'utente, la password no)</span>
                    <select class="input" name="Extras[__i__].PasswordId">
                        <option value="">Nessuna credenziale</option>
                        @foreach (var p in linked)
                        {
                            <option value="@p.Id">@PasswordLabel(p, asset)</option>
                        }
                    </select>
                </label>
                @if (Info.RustDeskEnabled)
                {
                    <div class="field">
                        <label class="field">
                            <span>Gateway RustDesk</span>
                            <input class="input mono" name="Extras[__i__].Gateway" list="peer-list" data-peer-input placeholder="Automatico (come la principale)" autocomplete="off" spellcheck="false" />
                        </label>
                        <label class="check check-inline">
                            <input type="checkbox" name="Extras[__i__].NoGateway" value="true" data-no-gateway />
                            <span>Nessun gateway: solo connessione diretta</span>
                        </label>
                    </div>
                }
            </div>
            <partial name="_ConnectionAdvanced" model="@(new ConnectionAdvancedModel("Extras[__i__].", null, null, null, null, Model.RdpDefaults, Model.WebDefaults))" />
            <div class="conn-panel-actions">
                <button type="button" class="btn btn-ghost btn-sm danger" data-extra-delete><svg><use href="#i-trash" /></svg>Elimina questa connessione</button>
            </div>
        </section>
    </template>
    <datalist id="ipam-list">
        @foreach (var ip in ipam)
        {
            <option value="@ip"></option>
        }
    </datalist>

    <fieldset class="card-fieldset">
        <legend>Asset</legend>
        <div class="grid grid-2">
            <label class="field">
                <span>Nota per i tecnici</span>
                <textarea class="input" name="Note" rows="2" maxlength="500" placeholder="es. Usare l'utente locale, il dominio è fuori uso">@setting?.Note</textarea>
            </label>
            <label class="check">
                <input type="checkbox" name="Hidden" value="true" checked="@(setting?.Hidden == true)" />
                <span>Nascondi questo asset (non collegabile o dismesso)</span>
            </label>
        </div>
    </fieldset>

    <footer class="modal-foot">
        @if (setting is not null)
        {
            <span class="muted small">Ultima modifica: @setting.UpdatedBy, @Format.Relative(setting.UpdatedAt)</span>
        }
        <div class="actions">
            <button type="button" class="btn btn-secondary" data-close-modal>Annulla</button>
            <button type="submit" class="btn btn-primary">Salva</button>
        </div>
    </footer>
</form>
